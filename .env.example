# =============================================================================
# Kasm + Proxmox dynamic VDI — configuration
# -----------------------------------------------------------------------------
# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
#
# Every script sources lib/common.sh, which loads this file and validates the
# variables it needs. Anything left blank is reported by `scripts/00-preflight.sh`.
# =============================================================================

# --- Proxmox node: SSH access (used to build templates & configure the node) --
# Scripts run `qm`, `pveum`, `pvesh` on the node over SSH.
PROXMOX_HOST="10.0.0.10"            # IP or hostname of the Proxmox node
PROXMOX_SSH_USER="root"             # must be able to run qm/pveum
PROXMOX_SSH_PORT="22"
PROXMOX_NODE="pve"                  # node name as shown in the Proxmox cluster
PROXMOX_SSH_KEY="$HOME/.ssh/id_ed25519"   # private key for the SSH connection

# --- Proxmox API token (created by 10-proxmox-setup.sh, consumed by Kasm) -----
# Kasm itself talks to the Proxmox REST API with this token to clone/start/stop
# the agent VMs. The token secret is printed once by the setup script.
PROXMOX_API_HOST="https://10.0.0.10:8006"
PROXMOX_API_USER="kasm@pve"        # the API user the token belongs to
PROXMOX_API_TOKEN_NAME="autoscale" # token id -> full id is kasm@pve!autoscale
PROXMOX_API_ROLE="KasmAutoscale"   # custom role created on the node
PROXMOX_POOL="kasm-autoscale"      # resource pool the agent VMs live in
PROXMOX_VERIFY_TLS="false"         # most home/lab nodes use a self-signed cert

# --- Agent VM template (Docker-agent autoscale pool) -------------------------
TEMPLATE_VMID="9000"
TEMPLATE_NAME="kasm-agent-template"
TEMPLATE_CORES="4"
TEMPLATE_MEMORY_MB="8192"
TEMPLATE_DISK_GB="60"
TEMPLATE_STORAGE="local-lvm"       # storage for the VM disk
TEMPLATE_SNIPPET_STORAGE="local"   # storage with the "snippets" content type
TEMPLATE_BRIDGE="vmbr0"
TEMPLATE_VLAN=""                   # optional VLAN tag, e.g. 20 (blank = none)
CLOUD_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
CLOUD_INIT_USER="kasm"
# Public key injected into the template so you can SSH in to debug.
SSH_PUBKEY_FILE="$HOME/.ssh/id_ed25519.pub"
# Workspace images to pre-pull into the template so sessions start instantly.
KASM_PREPULL_IMAGES="kasmweb/chrome:1.16.0"

# --- Server-pool template (full-desktop VMs, Horizon-style) ------------------
SERVER_TEMPLATE_VMID="9001"
SERVER_TEMPLATE_NAME="kasm-desktop-template"
SERVER_TEMPLATE_CORES="2"
SERVER_TEMPLATE_MEMORY_MB="4096"
SERVER_TEMPLATE_DISK_GB="40"

# --- Kasm control plane ------------------------------------------------------
KASM_HOST="https://10.0.0.20"      # URL of the Kasm UI / API
KASM_VERSION="1.16.1"
KASM_VERIFY_TLS="false"
# Developer API key (Admin -> Settings -> Developer / API). Used by the test
# and helper scripts to talk to Kasm's public API.
KASM_API_KEY=""
KASM_API_KEY_SECRET=""

# --- Autoscale tuning (values fed into the Kasm autoscale config) ------------
AUTOSCALE_STANDBY_CORES="4"        # warm capacity kept ready (0 = scale from cold)
AUTOSCALE_STANDBY_MEM_GB="8"
AUTOSCALE_DOWNSCALE_BACKOFF="600"  # seconds idle before an agent is destroyed
AUTOSCALE_AGENT_CORES_OVERRIDE="4"
AUTOSCALE_AGENT_MEM_OVERRIDE="8"

# --- Scale test --------------------------------------------------------------
TEST_SESSIONS="3"                  # how many concurrent sessions 50-scale-test creates
TEST_IMAGE_NAME="kasmweb/chrome:1.16.0"
TEST_POLL_SECONDS="10"
TEST_DURATION_SECONDS="300"

# --- Windows desktop-pool template (Horizon-style, full Windows VMs) ----------
# Build with scripts/proxmox/22-build-windows-template.sh. See
# docs/WINDOWS-DESKTOP-POOL.md. You must supply the ISOs yourself (licensing).
WIN_TEMPLATE_VMID="9002"
WIN_TEMPLATE_NAME="kasm-win-template"
WIN_TEMPLATE_CORES="4"
WIN_TEMPLATE_MEMORY_MB="8192"
WIN_TEMPLATE_DISK_GB="80"
WIN_OSTYPE="win11"                 # win11 | win10 | win2k22 | win2k19
WIN_ISO_STORAGE="local"            # storage that holds ISOs (content type: iso)
WIN_ISO="Win11_24H2_English_x64.iso"          # filename under <iso_storage>/template/iso
WIN_VIRTIO_ISO="virtio-win.iso"                # https://fedorapeople.org/groups/virt/virtio-win/
# Local admin baked into the image (Kasm can override per-provision). The answer
# file stores this in PLAINTEXT — use a throwaway value and rotate after sysprep.
WIN_ADMIN_USER="kasm"
WIN_ADMIN_PASSWORD="ChangeMe123!"
WIN_LOCALE="en-US"
WIN_TIMEZONE="UTC"
# Optional product key (blank = skip / KMS / volume activation handled later).
WIN_PRODUCT_KEY=""
