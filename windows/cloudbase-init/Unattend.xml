<?xml version="1.0" encoding="utf-8"?>
<!--
  Unattend.xml — the sysprep answer file. Pass this to sysprep when sealing the
  template so Cloudbase-Init runs during specialize on every clone's first boot:

    cd "C:\Windows\System32\Sysprep"
    .\sysprep.exe /generalize /oobe /shutdown ^
       /unattend:"C:\Program Files\Cloudbase Solutions\Cloudbase-Init\conf\Unattend.xml"

  After /shutdown the VM powers off generalized — that's when you convert it to a
  Proxmox template (the finalize step of 22-build-windows-template.sh).
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend"
          xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- Hand control to Cloudbase-Init during specialize on each clone. -->
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>"C:\Program Files\Cloudbase Solutions\Cloudbase-Init\Python\Scripts\cloudbase-init.exe" --config-file "C:\Program Files\Cloudbase Solutions\Cloudbase-Init\conf\cloudbase-init-unattend.conf"</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
